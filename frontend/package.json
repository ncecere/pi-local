{
  "name": "pi-local-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Pi Local's chat UI (ported from pi-agent-interface): served by the Go backend through the Wails asset server",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:fake": "node dev/fake-server.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.21",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "ai": "7.0.55",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "happy-dom": "20.14.5",
    "katex": "0.18.2",
    "lucide-react": "1.29.0",
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
